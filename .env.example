# Copiar a .env y rellenar con valores reales. Nunca commitear .env.

# --- Aplicación ---
APP_ENV=development
APP_SECRET_KEY=cambia-esto-por-un-valor-aleatorio-largo
APP_BASE_URL=https://deca.tudominio.es
# Fuera de development MADeCa no arranca si APP_BASE_URL no empieza por
# https:// (Apartado Tercero.1 BOE-A-2026-12784): va detrás de un proxy
# HTTPS (Caddy, nginx, Traefik...). Indica la IP del proxy (o * si solo el
# proxy llega a MADeCa) para que la IP real del cliente se tome de
# X-Forwarded-For: si no, el límite de intentos de acceso se comparte entre
# todos los usuarios y el registro de lecturas del QR guarda la del proxy.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Base de datos ---
DATABASE_URL=postgresql+psycopg://madeca:madeca@localhost:5432/madeca

# --- Redis (rate limiting, colas) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT dashboard ---
JWT_SECRET_KEY=cambia-esto-tambien-valor-aleatorio-largo
JWT_EXPIRE_MINUTES=480

# --- Almacenamiento de PDFs ---
# "local" o "s3"
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage/pdfs
# Si STORAGE_BACKEND=s3:
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Retención legal (Apartado Segundo.4 y Tercero.5 BOE-A-2026-12784) ---
RETENTION_DAYS=365
PUBLIC_URL_DEACTIVATION_DAYS=7

# Zona de las horas que llegan sin desfase y del panel: Europe/Madrid
# (península, Baleares, Ceuta, Melilla) o Atlantic/Canary.
ZONA_HORARIA=Europe/Madrid

# --- Hot-folder ERP (a3ERP / Sigrid / genérico) ---
HOTFOLDER_INCOMING_PATH=./hotfolder_watch/incoming
HOTFOLDER_PROCESSED_PATH=./hotfolder_watch/processed
HOTFOLDER_ERROR_PATH=./hotfolder_watch/errores

# --- Obtención de datos de documentos (bandeja de revisión) ---
# Ruta de Tesseract si no está en el PATH (en Docker ya viene instalado).
TESSERACT_RUTA=
# Tiempo máximo de OCR por página (segundos) y lecturas simultáneas.
OCR_LIMITE_SEGUNDOS=60
OCR_SIMULTANEOS=2
# Azure AI Document Intelligence (opcional, recurso en región UE). Solo se
# usa para las empresas que lo autoricen en «Fuentes de datos».
AZURE_DI_ENDPOINT=
AZURE_DI_CLAVE=
DOCUMENTO_ORIGEN_MAX_BYTES=20971520

# --- Fuentes de datos automáticas ---
# Solo instalaciones propias: permitir fuentes en redes privadas (SAP/Odoo
# internos). En la nube, dejar en false (protección SSRF).
FUENTES_PERMITIR_RED_PRIVADA=false
# Solo instalaciones propias: carpeta montada (NAS); cada empresa ve
# <base>/<id_empresa>/. Vacío = desactivado.
FUENTES_CARPETA_BASE=
CONECTORES_CICLO_SEGUNDOS=60

# --- Avisos diarios por correo a los administradores (opcional) ---
# Certificados que caducan, borradores sin revisar más de 24 h y fuentes
# con error. Sin SMTP_HOST no se envía nada. SMTP_SEGURIDAD: starttls
# (puerto 587), ssl (465) o ninguna (solo en red interna).
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=
SMTP_SEGURIDAD=starttls
AVISOS_CORREO_HORA=8
