# Proxy HTTPS de MADeCa. Caddy pide y renueva solo el certificado de
# Let's Encrypt para el dominio: el registro DNS (A) del dominio debe apuntar
# a este servidor y los puertos 80 y 443 deben llegar desde internet.
# MADeCa exige HTTPS (Apartado Tercero.1 BOE-A-2026-12784).

{
	email {$CORREO_ACME}
}

{$DOMINIO} {
	encode gzip
	request_body {
		max_size 25MB
	}
	reverse_proxy app:8000
	header Strict-Transport-Security "max-age=31536000"
}
